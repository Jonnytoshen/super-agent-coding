# This is an example .env file. Copy this to .env and fill in the values.

# The API key for Dashscope. You can get this from https://dashscope.com/account/api-keys
DASHSCOPE_API_KEY=your_api_key_here

# Web search API keys, you can get them from https://serper.dev/ and https://tavily.com/
# If you don't have them, you can leave them blank, but the web search feature won't work.
TAVILY_API_KEY=your_tavily_api_key_here
# Or if you prefer Serper:
SERPER_API_KEY=your_serper_api_key_here

# GitHub Personal Access Token, needed if you want to use the GitHub MCP Server. You can create one 
# at [GitHub Settings](https://github.com/settings/tokens)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here